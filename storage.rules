rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to verify admin access
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.email in [
          'skmobileshoppyandelectronics@gmail.com',
          'patelw401@gmail.com',
          'admin@skmobile.com',
          'admin.skmobile@gmail.com'
        ]
      );
    }

    // Reels videos: Public read so customers can stream videos smoothly
    // Only authorized admins can upload (max 50MB, video/* content type) or delete
    match /reels/{reelFile} {
      allow read: if true;
      allow write: if isAdmin() &&
                   request.resource.size < 50 * 1024 * 1024 &&
                   request.resource.contentType.matches('video/.*');
      allow delete: if isAdmin();
    }

    // Video thumbnails: Public read; Admin write
    match /thumbnails/{thumbFile} {
      allow read: if true;
      allow write: if isAdmin() &&
                   request.resource.size < 5 * 1024 * 1024 &&
                   request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }
  }
}
