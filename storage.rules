rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to verify admin access
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.get('admin', false) == true ||
        (request.auth.token.get('email_verified', false) == true && request.auth.token.get('email', '') in [
          'skmobileshoppyandelectronics@gmail.com',
          'patelw401@gmail.com',
          'admin@skmobile.com',
          'admin.skmobile@gmail.com'
        ])
      );
    }

    // Reels videos: Public read so customers can stream videos smoothly
    // Only authorized admins can upload (max 50MB, video/* content type) or delete
    match /reels/{reelFile} {
      allow read: if true;
      allow write: if isAdmin() &&
                   request.resource.size < 50 * 1024 * 1024 &&
                   request.resource.contentType.matches('video/.*');
      allow delete: if isAdmin();
    }

    // Product images (uploaded from the website admin panel and the Android admin app):
    // Public read so the storefront and the APK can display them; only admins can upload
    // (max 5MB, image/* content type) or delete. Path: products/{productId}/{timestamp}.jpg
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() &&
                   request.resource.size < 5 * 1024 * 1024 &&
                   request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // Video thumbnails: Public read; Admin write
    match /thumbnails/{thumbFile} {
      allow read: if true;
      allow write: if isAdmin() &&
                   request.resource.size < 5 * 1024 * 1024 &&
                   request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }
  }
}
